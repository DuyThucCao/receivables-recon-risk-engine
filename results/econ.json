{
  "name": "econ",
  "question": "Q7 Consulting economist: which payers underpay against contract, by how much, and why would they?",
  "label_note": "Simulated payers and claims for a fictional hospital; SOFR is the only real series. Results show parameter recovery and decision logic, not findings about real payers.",
  "seed": 20260331,
  "cutoff": {
    "as_of_date": "2026-03-31",
    "service_start": "2024-01-01",
    "service_end": "2025-12-31",
    "years_of_service_dates": 1.999
  },
  "inputs": {
    "tables": [
      "recon.claim_line_balance",
      "recon.claim_line_status",
      "recon.claim_remit_match",
      "core.fact_remit_line",
      "core.fact_claim_event",
      "core.fact_claim_line",
      "core.dim_contract_rate (through recon.claim_line_balance.expected_allowed)"
    ],
    "sql": [
      "sql/models/63_econ_underpayment.sql",
      "sql/models/64_econ_float.sql",
      "sql/models/65_econ_appeals.sql"
    ],
    "sofr": {
      "source": "FRED SOFR daily series, monthly mean",
      "label": "observed_public",
      "path": "SOFR.csv"
    }
  },
  "assumptions": {
    "shortfall_tolerance_usd": {
      "value": 0.01,
      "label": "financial_assumption",
      "note": "A line counts as priced below contract if allowed is at least one cent below the contract amount. Contract arithmetic in this data set is exact to the cent; real data would need a wider tolerance for rounding. Value from config/calibration.yaml."
    },
    "prompt_pay_days": {
      "value": 30,
      "label": "financial_assumption",
      "note": "Days from submission after which a payment counts as late. A round assumption, not a statute; prompt-pay windows differ by state, payer type and claim type. Value from config/calibration.yaml."
    },
    "bootstrap_reps": {
      "value": 2000,
      "label": "financial_assumption",
      "note": "Bootstrap replicates per payer."
    },
    "p_win_dispute_alt": {
      "value": 0.9,
      "label": "financial_assumption",
      "note": "Sensitivity: assumed win rate for an underpayment dispute, where the contract rate is documented (likely higher than the denial-appeal win rate used as the base case). Value from config/calibration.yaml."
    },
    "prompt_pay_interest_rate": {
      "value": 0.12,
      "label": "financial_assumption",
      "note": "Illustrative contract clause: simple interest per year owed on late or short payments. Assumed, not taken from any statute or contract. Value from config/calibration.yaml."
    },
    "renewal_discount_factor": {
      "value": 0.9,
      "label": "financial_assumption",
      "note": "Weight the payer puts on next contract period relative to this one (probability of renewal x time discount). Illustrative. Value from config/calibration.yaml."
    }
  },
  "appeal_cost_usd": {
    "value": 45.0,
    "label": "financial_assumption",
    "note": "cfg financial_assumptions.appeal_handling_cost_usd"
  },
